# Dart / pub
.dart_tool/
.packages
build/
doc/api/
.flutter-plugins
.flutter-plugins-dependencies
# `dart test --coverage=coverage` writes this into each package directory.
coverage/

# Melos / workspace
.melos_tool/
melos_*.iml

# NOTE: pubspec.lock is intentionally NOT ignored. Melos 8 / pub workspaces
# resolve the whole workspace through a single root lockfile, which must be
# committed for reproducible CI and local bootstrap.

# AOT artifacts
*.aot
*.snapshot
dist/

# Local AlteriOne state — user data and generated modules must never be committed.
# The name is the installed product's, so a developer checkout and a user's install
# root are ignored by the same rule. See ADR-0016.
.alterione/
.alteri_one/

# Bootstrap CLI output. The publishable package lives in apps/bootstrap/; its build
# output must not land in the repository.
apps/bootstrap/.dart_tool/
apps/bootstrap/build/

# The project website. site/ is its own package with its own lockfile, deliberately
# outside the pub workspace — see docs/decisions/0020-project-website.md.
site/.dart_tool/
site/build/
site/.jaspr/

# Editors
.idea/
.vscode/
*.iml
*.swp

# OS
.DS_Store
Thumbs.db

**.lock